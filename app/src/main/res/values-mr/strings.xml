    <!-- Placeholder Screens -->
    <string name="profile_title">वरिष्ठ आरोग्य प्रोफाइल</string>
    <string name="profile_placeholder">आपली आरोग्य प्रोफाइल आपत्कालीन प्रतिसादकर्त्यांना आपल्याला सर्वोत्तम काळजी प्रदान करण्यात मदत करेल.\n\nहे वैशिष्ट्य फेज 2 मध्ये लागू केले जाईल.</string>
    
    <string name="contacts_title">आपत्कालीन संपर्क</string>
    <string name="contacts_placeholder">आपत्कालीन परिस्थितींमध्ये कुटुंबातील सदस्य आणि काळजीवाहक जोडा ज्यांना सूचित केले जावे.\n\nहे वैशिष्ट्य फेज 2 मध्ये लागू केले जाईल.</string>
    
    <string name="journey_title">आपत्कालीन प्रवास</string>
    <string name="journey_placeholder">लक्षण अहवालापासून रुग्णालयातील काळजीपर्यंत आपल्या आपत्कालीन प्रवासाचा मागोवा घ्या.\n\nहे वैशिष्ट्य नंतरच्या टप्प्यांमध्ये लागू केले जाईल.</string>
    
    <string name="emergency_start_title">आपत्कालीन सक्रियकरण</string>
    <string name="emergency_start_message">आपत्कालीन कार्यप्रवाह लागू केला जात आहे.\n\nहा प्रोटोटाइप वास्तविक आपत्कालीन सेवांशी संपर्क साधत नाही.\n\nसंपूर्ण आपत्कालीन लक्षण कॅप्चर आणि ट्रायेज फेज 3 मध्ये उपलब्ध होईल.</string>
    <string name="emergency_start_button">पुढे चला</string>
    
    <string name="symptom_capture_title">लक्षण कॅप्चर</string>
    <string name="symptom_capture_message">आवाज-आधारित लक्षण अहवाल फेज 3 मध्ये लागू केला जाईल.\n\nतुम्ही बोलून तुमच्या लक्षणांचे वर्णन करू शकाल आणि आयुष तुमच्या परिस्थितीची तातडीचा आकलन करण्यात मदत करेल.</string>
    
